{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pao",
  "version": "0.1.0",
  "identifier": "dev.pao.viewer",
  "build": {
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../../gui" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../../gui" },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../gui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pao",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
